# ============================================================================
# Mealzy Bot Configuration
# ============================================================================

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Groq API Key (free tier available at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# LLM Model (default is good, but you can change it)
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================================
# Bot Personalization
# ============================================================================

# Name of your bot (displayed to users)
BOT_NAME=Prakhya

# ============================================================================
# Coach Notifications
# ============================================================================

# Telegram chat/group ID where completed onboarding data is forwarded
# Leave blank if you don't want notifications
FORWARD_CHAT_ID=your_coach_chat_id_here

# ============================================================================
# Voice Transcription (Optional)
# ============================================================================

# Enable voice note transcription via Groq Whisper
VOICE_TRANSCRIPTION_ENABLED=false

# ============================================================================
# Stickers (Optional but delightful)
# ============================================================================

# Enable sticker support
STICKERS_ENABLED=false

# Sticker file IDs (get from @RawDataBot on Telegram)
STICKER_WAVE=
STICKER_FIRE=
STICKER_CELEBRATE=
STICKER_THINKING=
STICKER_LOVE=
STICKER_MUSCLE=
